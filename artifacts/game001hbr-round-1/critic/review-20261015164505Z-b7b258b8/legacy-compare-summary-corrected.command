python3 -c "import json; d=json.load(open('/private/tmp/game-001hbr-critic-evidence/review-20261015164505Z-b7b258b8/legacy-compare.stdout')); out={}; [(out.setdefault(s,{}).update({k:({'equal':v['equal'],'tick':v['parent'].get('tick'),'snapshotHash':v['parent'].get('snapshotHash'),'replayHash':v['parent'].get('replayHash')} if isinstance(v['parent'],dict) and 'snapshotHash' in v['parent'] else {'equal':v['equal'],'parent':v['parent'],'candidate':v['candidate']})})) for s,entries in d['comparisons'].items() for k,v in entries.items()]; print(json.dumps({'allEqual':d['allEqual'],'comparisons':out},indent=2))"
