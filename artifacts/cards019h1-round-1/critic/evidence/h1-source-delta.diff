125 export function resolveOrdinaryProjectileHomingTarget(projectile, externalById,
126   units, damage, controls) {
127   const targetStructure = Object.hasOwn(projectile, "structureId")
128     ? externalById.get(projectile.targetId) ?? null : null;
129   const targetUnit = targetStructure === null
130     ? units.find(({ id }) => id === projectile.targetId) ?? null : null;
131   const targetHealth = targetUnit === null ? null : damage.get(projectile.targetId);
132   const target = targetStructure ?? targetUnit;
133   const available = targetStructure !== null
134     ? targetStructure.structureId === projectile.structureId &&
135       targetStructure.side === projectile.structureSide &&
136       targetStructure.kind === projectile.structureKind &&
137       targetStructure.layer === projectile.structureLayer &&
138       targetStructure.alive && targetStructure.targetable
139     : targetUnit !== null && targetHealth !== null && !targetHealth.dead &&
140       (controls.get(projectile.targetId)?.targetable ?? true);
141   return available ? target : null;
142 }
