 62 export function advanceOrdinaryProjectileHoming({ position, targetPosition, targetRadius, speed }) {
 63   const dx = BigInt(targetPosition.x) - BigInt(position.x);
 64   const dy = BigInt(targetPosition.y) - BigInt(position.y);
 65   const distanceSquared = dx * dx + dy * dy;
 66   const contactDistance = BigInt(targetRadius);
 67   const stepDistance = BigInt(speed);
 68   const reach = contactDistance + stepDistance;
 69   if (distanceSquared <= reach * reach) {
 70     return { contact: true, position: { ...targetPosition } };
 71   }
 72   const distance = ceilingSquareRoot(distanceSquared);
 73   const stepX = dx * stepDistance / distance;
 74   const stepY = dy * stepDistance / distance;
 75   return {
 76     contact: false,
 77     position: {
 78       x: Number(BigInt(position.x) + stepX),
 79       y: Number(BigInt(position.y) + stepY),
 80     },
 81   };
 82 }
 83 
 84 export function advanceOrdinaryProjectileQueue({ projectiles, tick, maxTick, resolveTarget }) {
 85   const due = [];
 86   const pending = [];
 87   for (const projectile of projectiles) {
 88     if (projectile.impactTick !== tick) {
 89       pending.push(projectile);
 90       continue;
 91     }
 92     if (projectile.splashProfile?.homing !== true) {
 93       due.push(projectile);
 94       continue;
 95     }
 96     const target = resolveTarget(projectile);
 97     if (target === null) {
 98       due.push(projectile);
 99       continue;
100     }
101     const movement = advanceOrdinaryProjectileHoming({
102       position: projectile.position,
103       speed: projectile.speed,
104       targetPosition: target.position,
105       targetRadius: target.radius,
106     });
107     const advanced = {
108       ...projectile,
109       impactTick: movement.contact ? tick : tick + 1,
110       position: movement.position,
111       targetPosition: { ...target.position },
112     };
113     if (movement.contact) due.push(advanced);
114     else {
115       if (tick >= maxTick) {
116         throw new RangeError("homing projectile continuation exceeds tick bounds");
117       }
118       pending.push(advanced);
119     }
120   }
121   due.sort((left, right) => left.id - right.id);
122   return { due, pending };
123 }
