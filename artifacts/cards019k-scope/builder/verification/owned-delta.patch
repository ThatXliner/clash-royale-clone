+  deployTimeTicks: 60,
+  rangeMillitiles: 5_500,
+  sightRangeMillitiles: 5_500,
+  movementMillitilesPerSecond: 1_000,
+  targetMode: "ground-and-air",
+  count: 1,
+  areaDamageRadiusMillitiles: null,
+  components: [],
