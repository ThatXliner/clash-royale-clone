 40 function policyAudit(sessionBytes) {
 41   const { setup } = JSON.parse(sessionBytes);
 42   const battleSetup = JSON.parse(setup.battleSetup);
 43   const card = battleSetup.roster.find(({ buildingRuntime }) =>
 44     buildingRuntime?.class === "defensive" &&
 45     buildingRuntime.policy?.disposition === "question");
 46   if (card === undefined) return null;
 47   return {
 48     cardId: card.id,
 49     fields: Object.fromEntries(Object.entries(card.buildingRuntime.policy.corpusFields)
 50       .map(([field, record]) => [field, record.authoritative])),
 51   };
 52 }
