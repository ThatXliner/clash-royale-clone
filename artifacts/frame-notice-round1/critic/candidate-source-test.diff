 83 async function readFirstLine(stream) {
 84   let buffered = "";
 85   stream.setEncoding("utf8");
 86   for await (const chunk of stream) {
 87     buffered += chunk;
 88     const end = buffered.indexOf("\n");
 89     if (end >= 0) return buffered.slice(0, end);
 90   }
 91   throw new Error("policy notice server exited before readiness");
 92 }
