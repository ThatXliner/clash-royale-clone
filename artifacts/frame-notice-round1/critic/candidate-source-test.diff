 54 function expectedNotice(sessionBytes) {
 55   const { setup } = JSON.parse(sessionBytes);
 56   const battleSetup = JSON.parse(setup.battleSetup);
 57   const card = battleSetup.roster.find(({ buildingRuntime }) =>
 58     buildingRuntime?.class === "defensive" &&
 59     buildingRuntime.policy?.disposition === "question");
 60   if (card === undefined) {
 61     return {
 62       cardId: null,
 63       disposition: null,
 64       hidden: true,
 65       text: "",
 66       unverifiedFields: null,
 67     };
 68   }
 69   const fields = card.buildingRuntime.policy.corpusFields;
 70   const unverifiedFields = Object.entries(fields)
 71     .filter(([, field]) => field.authoritative !== true)
 72     .map(([field]) => field);
 73   return {
 74     cardId: card.id,
 75     disposition: "question",
 76     hidden: false,
 77     text: `${card.displayName} combat: QUESTION. First-hit timing is ${fields.firstHitTicks.value === null
 78       ? "absent" : "unverified"}; damage, HP, deploy, range and target fields are unverified.`,
 79     unverifiedFields: unverifiedFields.join(","),
 80   };
 81 }
