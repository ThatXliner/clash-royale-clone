 94 async function stopServer(server) {
 95   if (server === undefined || server.exitCode !== null) return true;
 96   const exited = once(server, "exit").then(() => true, () => false);
 97   server.kill("SIGTERM");
 98   let didExit = await Promise.race([
 99     exited, new Promise((resolve) => setTimeout(() => resolve(false), 2_000)),
100   ]);
101   if (!didExit && server.exitCode === null) {
102     server.kill("SIGKILL");
103     didExit = await Promise.race([
104       exited, new Promise((resolve) => setTimeout(() => resolve(false), 2_000)),
105     ]);
106   }
107   return didExit && (server.exitCode !== null || server.signalCode !== null);
108 }
