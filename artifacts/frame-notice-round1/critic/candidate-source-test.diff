110 function makeForgedSession(sessionBytes) {
111   const forged = JSON.parse(sessionBytes);
112   const battleSetup = JSON.parse(forged.setup.battleSetup);
113   const card = battleSetup.roster.find(({ id }) => id === "buried-coil");
114   card.buildingRuntime.policy.corpusFields.damage.authoritative = true;
115   forged.setup.battleSetup = canonical(battleSetup);
116   forged.setup.rosterWitness = canonical({
117     questions: battleSetup.questions,
118     roster: battleSetup.roster,
119   });
120   return canonical(forged);
121 }
