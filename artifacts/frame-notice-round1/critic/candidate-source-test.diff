 25 function canonical(value) {
 26   if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
 27   if (value !== null && typeof value === "object") {
 28     return `{${Object.keys(value).sort().map((key) =>
 29       `${JSON.stringify(key)}:${canonical(value[key])}`).join(",")}}`;
 30   }
 31   return JSON.stringify(value);
 32 }
