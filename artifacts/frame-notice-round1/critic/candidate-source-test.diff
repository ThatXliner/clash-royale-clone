478       const controller = globalThis.__frameNoticeController;
479       const before = controller.serialize();
480       const envelope = JSON.parse(before);
481       envelope.session = forgedSession;
482       let error = null;
483       try { controller.restore(canonicalize(envelope)); }
484       catch (caught) { error = String(caught?.message ?? caught); }
485       return { after: controller.serialize(), before, error };
486       function canonicalize(value) {
487         if (Array.isArray(value)) return `[${value.map(canonicalize).join(",")}]`;
488         if (value !== null && typeof value === "object") {
489           return `{${Object.keys(value).sort().map((key) =>
490             `${JSON.stringify(key)}:${canonicalize(value[key])}`).join(",")}}`;
491         }
492         return JSON.stringify(value);
493       }
494     }, forgedSessionBytes);
