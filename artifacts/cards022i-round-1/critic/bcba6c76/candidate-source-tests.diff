 50 function serverReady(server, stdout, stderr) {
 51   return new Promise((resolve, reject) => {
 52     let pending = "";
 53     let resolved = false;
 54     const onData = (chunk) => {
 55       stdout.push(chunk.toString("utf8"));
 56       if (resolved) return;
 57       pending += chunk.toString("utf8");
 58       const newline = pending.indexOf("\n");
 59       if (newline < 0) return;
 60       resolved = true;
 61       try { resolve(JSON.parse(pending.slice(0, newline))); }
 62       catch (error) { reject(error); }
 63     };
 64     server.stdout.on("data", onData);
 65     server.stderr.on("data", (chunk) => stderr.push(chunk.toString("utf8")));
 66     server.once("exit", (code) => reject(new Error(
 67       `release server exited before readiness (${code})`)));
 68   });
 69 }
