 38 function describeError(error) {
 39   return {
 40     cause: error?.cause instanceof Error ? describeError(error.cause) : null,
 41     errors: Array.isArray(error?.errors)
 42       ? error.errors.map((nested) => ({ message: String(nested?.message ?? nested),
 43         name: nested?.name ?? null, stack: nested?.stack ?? null })) : [],
 44     message: String(error?.message ?? error),
 45     name: error?.name ?? null,
 46     stack: error?.stack ?? null,
 47   };
 48 }
