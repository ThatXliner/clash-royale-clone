 71 async function clickWorldPoint(page, arena, x, y) {
 72   const box = await arena.boundingBox();
 73   assert.ok(box && box.width > 0 && box.height > 0,
 74     "the released arena has a visible trusted-input surface");
 75   const metrics = await arena.evaluate((node) => ({
 76     borderLeft: node.clientLeft,
 77     borderTop: node.clientTop,
 78     clientHeight: node.clientHeight,
 79     clientWidth: node.clientWidth,
 80     rectHeight: node.getBoundingClientRect().height,
 81     rectWidth: node.getBoundingClientRect().width,
 82   }));
 83   const scaleX = box.width / metrics.rectWidth;
 84   const scaleY = box.height / metrics.rectHeight;
 85   await page.mouse.click(
 86     box.x + (metrics.borderLeft + metrics.clientWidth * x / 18_000) * scaleX,
 87     box.y + (metrics.borderTop + metrics.clientHeight * (32_000 - y) / 32_000) * scaleY,
 88   );
 89 }
