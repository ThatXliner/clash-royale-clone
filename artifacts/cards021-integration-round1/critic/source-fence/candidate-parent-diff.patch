275 async function exactTeamColorPixelsInViewport(screenshotPath, color, bounds) {
276   const script = [
277     "import json, math, sys",
278     "from PIL import Image",
279     "image = Image.open(sys.argv[1]).convert('RGBA')",
280     "target = tuple(int(part) for part in sys.argv[2].split(',')) + (255,)",
281     "bounds = json.loads(sys.argv[3])",
282     "left = max(0, math.floor(bounds['x']))",
283     "top = max(0, math.floor(bounds['y']))",
284     "right = min(image.width, math.ceil(bounds['x'] + bounds['width']))",
285     "bottom = min(image.height, math.ceil(bounds['y'] + bounds['height']))",
286     "crop = image.crop((left, top, right, bottom))",
287     "count = sum(1 for pixel in crop.getdata() if pixel == target)",
288     "print(json.dumps({'color': target[:3], 'count': count, 'crop': [left, top, right, bottom], 'size': crop.size}))",
289   ].join("\n");
290   const { stdout } = await execFileAsync("python3", ["-c", script, screenshotPath, color,
291     JSON.stringify(bounds)]);
292   return JSON.parse(stdout.trim());
