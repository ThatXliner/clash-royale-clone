173 async function waitForMatch(frame, moduleUrl, match, description, timeout = 45_000) {
174   await frame.waitForFunction(async ({ entryUrl, condition }) => {
175     const { arenaHudController } = await import(entryUrl);
176     const controller = arenaHudController;
177     const state = controller.session.state;
178     const replay = controller.session.replay;
179     const structures = state.battle.structures;
180     const projectiles = state.battle.projectiles;
181     const units = state.battle.units;
182     switch (condition.kind) {
183       case "deployment":
184         return replay.some((event) => event.side === condition.side && (
185           (event.type === "session-deployed" && event.deployment?.cardId === condition.cardId) ||
186           (event.type === "session-structure-deployed" &&
187             event.materialization?.cardId === condition.cardId)
188         ));
189       case "both-hidden-coils":
190         return ["north", "south"].every((side) => structures.some((structure) =>
191           structure.cardId === "buried-coil" && structure.side === side &&
192           structure.alive && structure.hidden
193         ));
194       case "hand-card":
195         return state.decks.south.hand.includes(condition.cardId) &&
196           state.elixir.sides.south.amount >= condition.minimumElixir;
197       case "revealed-coil":
198         return structures.some((structure) => structure.cardId === "buried-coil" &&
199           structure.alive && !structure.hidden);
200       case "structure-attack": {
201         const coilIds = new Set(structures.filter((structure) =>
202           structure.cardId === "buried-coil").map((structure) => structure.id));
203         return replay.some((event) => event.type === "structure-attack" &&
204           coilIds.has(event.buildingId) && units.some((unit) =>
205             unit.id === event.targetId && unit.layer === condition.layer));
206       }
207       case "projectile":
208         return projectiles.length > 0;
209       case "hidden-coil":
210         return structures.some((structure) => structure.cardId === "buried-coil" &&
211           structure.alive && structure.hidden);
212       default:
213         throw new Error(`unknown Cards021 browser condition: ${condition.kind}`);
214     }
215   }, { entryUrl: moduleUrl, condition: match }, { timeout, polling: "raf" })
216     .catch((error) => { throw new Error(`timed out waiting for ${description}: ${error.message}`); });
217 }
