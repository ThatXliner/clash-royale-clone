219 async function advanceUntilMatch(frame, moduleUrl, match, description, maxTicks) {
220   const result = await frame.evaluate(async ({ entryUrl, condition, limit }) => {
221     const { arenaHudController: controller } = await import(entryUrl);
222     const matches = () => {
223       const state = controller.session.state;
224       const replay = controller.session.replay;
225       const structures = state.battle.structures;
226       const projectiles = state.battle.projectiles;
227       const units = state.battle.units;
228       switch (condition.kind) {
229         case "deployment":
230           return replay.some((event) => event.side === condition.side && (
231             (event.type === "session-deployed" && event.deployment?.cardId === condition.cardId) ||
232             (event.type === "session-structure-deployed" &&
233               event.materialization?.cardId === condition.cardId)
234           ));
235         case "hand-card":
236           return state.decks.south.hand.includes(condition.cardId) &&
237             state.elixir.sides.south.amount >= condition.minimumElixir;
238         case "revealed-coil":
239           return structures.some((structure) => structure.cardId === "buried-coil" &&
240             (condition.side === undefined || structure.side === condition.side) &&
241             structure.alive && !structure.hidden);
242         case "structure-attack": {
243           const coilIds = new Set(structures.filter((structure) =>
244             structure.cardId === "buried-coil").map((structure) => structure.id));
245           return replay.some((event) => event.type === "structure-attack" &&
246             coilIds.has(event.buildingId) && units.some((unit) =>
247               unit.id === event.targetId && unit.layer === condition.layer));
248         }
249         case "projectile":
250           return projectiles.length > 0;
251         case "hidden-coil":
252           return structures.some((structure) => structure.cardId === "buried-coil" &&
253             (condition.side === undefined || structure.side === condition.side) &&
254             structure.alive && structure.hidden);
255         case "terminal":
256           return state.terminal;
257         default:
258           throw new Error(`unknown Cards021 step condition: ${condition.kind}`);
259       }
260     };
261     let steps = 0;
262     while (!matches() && steps < limit && !controller.session.state.terminal) {
263       const batch = condition.kind === "terminal" ? Math.min(30, limit - steps) : 1;
264       controller.stepMany(batch);
265       steps += batch;
266     }
267     return { matched: matches(), steps, terminal: controller.session.state.terminal,
268       tick: controller.session.state.tick };
269   }, { entryUrl: moduleUrl, condition: match, limit: maxTicks });
270   assert.ok(result.matched,
271     `${description} did not occur within ${maxTicks} canonical ticks; result=${JSON.stringify(result)}`);
272   return result;
273 }
