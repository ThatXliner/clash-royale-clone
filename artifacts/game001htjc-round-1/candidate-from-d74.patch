+  const structure = battle.state.structures.find(({ cardId }) => cardId === "bulwark-needle");
+  const structureDamage = chainHop2Events.find(({ buildingId, sourceId: damageSource, type }) =>
+    type === "structure-damaged" && buildingId === structure.id && damageSource?.startsWith("chain:"));
+  assert.ok(structureDamage, `the building health writer accepts the selected hop; chain events: ${
