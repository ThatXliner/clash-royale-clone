+const PROJECTILE_MANIFEST = createSessionTroopProjectileProfileManifest();
+const SPELL_RECEIPTS = createSessionSpellProfileReceipts();
+const MAX_CHAIN_TICKS = 1_200;
+
+function canonical(value) {
+  if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
+  if (value !== null && typeof value === "object") {
+    return `{${Object.keys(value).sort().map((key) =>
+      `${JSON.stringify(key)}:${canonical(value[key])}`).join(",")}}`;
+  }
+  return JSON.stringify(value);
+}
+
+function clone(value) {
+  return structuredClone(value);
+}
+
+function questionInventory(roster, supplemental = []) {
+  const referenced = new Set();
+  const visit = (value) => {
+    if (Array.isArray(value)) {
+      value.forEach(visit);
+    } else if (value !== null && typeof value === "object") {
+      for (const [key, child] of Object.entries(value)) {
+        if (key === "questionKey" && typeof child === "string") referenced.add(child);
+        else visit(child);
+      }
+    }
+  };
+  roster.filter(({ kind }) => kind === "unit").forEach(({ entities }) => visit(entities));
+  const available = new Map([...createPlayableRosterQuestionRecords(), ...supplemental]
+    .map((record) => [record.key, record]));
+  return [...referenced].sort().map((key) => {
+    const record = available.get(key);
+    assert.ok(record, `question receipt exists for ${key}`);
+    return record;
+  });
+}
+
+function hostSetup({ includeSource = true, tank = null, structureCard = null } = {}) {
+  const witness = includeSource ? createSessionTroopWitness("stormkite") : null;
+  const roster = clone(witness?.roster ?? createPlayableRoster());
+  roster[1] = clone(projectSessionNonUnitBattleCard("bulwark-needle"));
+  roster[7] = clone(projectSessionNonUnitBattleCard("squall-orb"));
+  const supplementalQuestions = [...(witness?.questions ?? [])];
+  if (tank !== null) {
+    const tankWitness = createSessionTroopWitness(tank);
+    roster[1] = clone(tankWitness.roster.find(({ id }) => id === tank));
+    supplementalQuestions.push(...tankWitness.questions);
+  }
+  if (structureCard !== null) {
+    roster[7] = clone(projectSessionNonUnitBattleCard(structureCard));
+  }
+  return {
+    initialWindupTicks: { central: 10_000, lane: 10_000 },
+    questions: questionInventory(roster, supplementalQuestions),
+    roster,
+    ...(roster.some(({ id }) => id === "squall-orb")
+      ? { spellProfileReceipts: SPELL_RECEIPTS } : {}),
+  };
+}
+
+function createBattle({ includeSource = true, chain = true, tank = null,
+  structureCard = null } = {}) {
+  const setup = hostSetup({ includeSource, tank, structureCard });
+  return new LiveBattle(canonical(setup), undefined, undefined, PROJECTILE_RECEIPT,
+    chain ? createStormkiteChainQuestionHostPolicy() : undefined);
+}
+
+function stageBattle(battle, { includeStructure = true } = {}) {
+  battle.scheduleDeploy(canonical({ cardId: "stormkite", point: { x: 3_500, y: 17_500 },
+    sequence: 0, side: "north", tick: 0 }));
+  battle.scheduleDeploy(canonical({ cardId: "mossguard", point: { x: 3_500, y: 14_000 },
+    sequence: 1, side: "south", tick: 0 }));
+  if (includeStructure) {
+    battle.scheduleStructure({ cardId: "bulwark-needle", destination: null,
+      point: { x: 3_500, y: 12_500 }, sequence: 2, side: "south", tick: 0 });
+  }
+  battle.step();
+}
+
+function chainState(battle) {
+  return JSON.parse(JSON.parse(battle.serialize()).chainRuntime).state;
+}
+
+function identityOf(event) {
+  return event.projectileIdentity ?? event.projectile?.projectileIdentity ?? null;
+}
+
+function projectileBoundarySources(count) {
+  const profile = PROJECTILE_MANIFEST.profiles.find(({ id }) => id === "stormkite");
+  assert.ok(profile, "Stormkite has an admitted projectile source profile");
+  return Array.from({ length: count }, (_, index) => ({
+    cardId: "stormkite",
+    damage: profile.sourceCard.damage,
+    delivery: "projectile",
+    layer: "ground",
+    maxHealth: profile.sourceCard.hitpoints,
+    projectileSpeed: 1,
+    rangeMillitiles: profile.sourceCard.rangeMillitiles,
+    sightRangeMillitiles: profile.sourceCard.sightRangeMillitiles,
+    side: "north",
+    sourceId: index + 1,
+    targetMode: profile.sourceCard.targetMode === "ground-and-air"
+      ? "air_and_ground" : profile.sourceCard.targetMode,
+  }));
+}
+
+function projectileObservation(sourceId, projectileId, type, overrides = {}) {
+  const projectileIdentity = {
+    attackSequence: 1,
+    direction: "unit-to-unit",
+    projectileId,
+    sourceId,
+  };
+  return {
+    projectileIdentity,
+    status: type === "projectile-impact" ? "contact" : undefined,
+    targetId: 50_000 + projectileId,
+    tick: 0,
+    type,
+    ...overrides,
+  };
+}
+
+function findPrimary(battle) {
+  for (let elapsed = 0; elapsed < MAX_CHAIN_TICKS; elapsed += 1) {
+    const events = battle.step();
+    const primary = events.find(({ type }) => type === "chain-primary-contact");
+    if (primary !== undefined) return { events, primary };
+  }
+  throw new Error("Stormkite did not produce an admitted host primary contact in the bound");
+}
+
+function scheduleKillSpells(battle, sourceId) {
+  const source = battle.state.units.find(({ id }) => id === sourceId);
+  assert.ok(source?.alive, "the target unit is live when the explicit spell commands are admitted");
+  for (const sequence of [0, 1]) {
+    battle.scheduleSpell({ cardId: "squall-orb", point: clone(source.position), sequence,
+      side: "south", target: { id: sourceId, kind: "unit" }, tick: battle.state.tick });
+  }
+}
+
+test("Stormkite opt-in hits the shared unit, building, and crown health owners through one tick", () => {
+  const battle = createBattle();
