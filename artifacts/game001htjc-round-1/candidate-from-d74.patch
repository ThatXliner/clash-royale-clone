+test("later-batch history overflow does not commit earlier candidate batches", () => {
+  const runtime = SessionTroopProjectileRuntime.fromReceipt(PROJECTILE_RECEIPT);
+  const eightSources = projectileBoundarySources(8);
+  const seedEvents = [];
+  for (let projectileId = 1; projectileId <= 1_364; projectileId += 1) {
+    const sourceId = ((projectileId - 1) % 8) + 1;
+    seedEvents.push(projectileObservation(sourceId, projectileId, "projectile-launch"));
+    if (projectileId <= 1_362) {
+      seedEvents.push(projectileObservation(sourceId, projectileId, "projectile-impact"));
+    }
+  }
+  runtime.step({ events: seedEvents, sources: eightSources, tick: 0 });
+  assert.equal(runtime.state.history.length, 4_088);
+  assert.equal(runtime.state.pending.length, 2);
+  const before = canonical(runtime.state);
+
+  const nineSources = projectileBoundarySources(9);
+  const finalBatchEvents = nineSources.map(({ sourceId }) =>
+    projectileObservation(sourceId, 5_000 + sourceId, "projectile-launch", { tick: 1 }));
+  assert.throws(() => stepLiveBattleProjectileBoundary(runtime, {
+    events: finalBatchEvents,
+    sources: nineSources,
+    tick: 1,
+  }), /history bound exceeded/u,
+  "the first eight roots fill the history cap and the ninth fails in a later chunk");
+  assert.equal(canonical(runtime.state), before,
+    "history and pending state remain byte-for-byte equivalent at the original runtime receiver");
+});
