+  assert.equal(primary.target.type, "unit");
+  assert.equal(primary.tick >= beforePrimaryTick, true);
+  const primaryTargetAfter = battle.state.units.find(({ id }) => id === primary.target.id).hitpoints;
+  assert.equal(primaryTargetBefore - primaryTargetAfter, 192,
+    "the actual BattleCombat primary contact applies Stormkite's 192 unit damage");
