+test("dead-before-primary cancellations are replay-derived and opt-in snapshots are exact", () => {
+  const battle = createBattle({ chain: true });
+  stageBattle(battle, { includeStructure: false });
+  const sourceId = battle.state.units.find(({ cardId }) => cardId === "stormkite").id;
+  let pendingLaunch = null;
+  for (let elapsed = 0; elapsed < MAX_CHAIN_TICKS && pendingLaunch === null; elapsed += 1) {
+    const events = battle.step();
+    const launch = events.find((event) => event.type === "projectile-launch" &&
+      identityOf(event)?.sourceId === sourceId);
+    if (launch === undefined) continue;
+    const identity = identityOf(launch);
+    const projectile = battle.state.projectiles.find((entry) =>
+      canonical(entry.projectileIdentity) === canonical(identity));
+    if (projectile !== undefined && projectile.impactTick > battle.state.tick) {
+      pendingLaunch = { identity, projectile };
+    }
+  }
+  assert.ok(pendingLaunch, "a real host primary is pending beyond the current boundary");
+  assert.ok(battle.state.projectileRuntime.pending.some(({ identity }) =>
+    canonical(identity) === canonical(pendingLaunch.identity)));
+
+  scheduleKillSpells(battle, sourceId);
+  const killEvents = battle.step();
+  assert.equal(battle.state.units.find(({ id }) => id === sourceId).alive, false);
+  assert.ok(battle.state.projectiles.some(({ projectileIdentity }) =>
+    canonical(projectileIdentity) === canonical(pendingLaunch.identity)),
+  "the primary stays pending through the ordinary same-boundary combat batch");
+
+  const cancelEvents = battle.step();
+  const cancellation = cancelEvents.find((event) => event.type === "projectile-impact" &&
+    event.status === "target_missing" &&
+    canonical(identityOf(event)) === canonical(pendingLaunch.identity));
+  assert.ok(cancellation, "the next boundary cancels the exact dead-source primary root");
+  assert.equal(cancelEvents.some((event) => event.type === "chain-primary-contact" &&
+    canonical(event.identity) === canonical(pendingLaunch.identity)), false);
+  assert.ok(killEvents.some(({ type, targetId }) => type === "death" && targetId === sourceId));
+  assert.equal(battle.state.projectileRuntime.pending.some(({ identity }) =>
+    canonical(identity) === canonical(pendingLaunch.identity)), false);
+
+  const optedSnapshot = battle.serialize();
+  assert.equal(LiveBattle.restore(optedSnapshot).serialize(), optedSnapshot,
+    "restore rederives the authorized cancellation from the exact source witness");
+  const unsupportedOuter = JSON.parse(optedSnapshot);
+  unsupportedOuter.version = 99;
+  assert.throws(() => LiveBattle.restore(canonical(unsupportedOuter)),
+    /unsupported live battle snapshot version/u,
+  "an additive chain witness does not alias or authorize an unsupported outer schema");
+
+  const unsupportedChainFormat = JSON.parse(optedSnapshot);
+  const unsupportedChainWitness = JSON.parse(unsupportedChainFormat.chainRuntime);
+  unsupportedChainWitness.formatVersion += 1;
+  unsupportedChainFormat.chainRuntime = canonical(unsupportedChainWitness);
+  assert.throws(() => LiveBattle.restore(canonical(unsupportedChainFormat)),
+    /policy receipt is invalid/u,
+  "the bounded additive chain schema rejects unsupported format versions");
+
+  const malformedChainShape = JSON.parse(optedSnapshot);
+  const malformedChainWitness = JSON.parse(malformedChainShape.chainRuntime);
+  malformedChainWitness.unexpectedField = true;
+  malformedChainShape.chainRuntime = canonical(malformedChainWitness);
+  assert.throws(() => LiveBattle.restore(canonical(malformedChainShape)),
+    /invalid shape/u,
+  "the additive chain schema rejects fields outside its exact shape");
+
+  const nestedBattle = JSON.parse(JSON.parse(optedSnapshot).battle);
+  assert.ok(nestedBattle.history.some(({ identities, type }) => type === "chain-cancel" &&
+    identities.some((identity) => canonical(identity) === canonical(pendingLaunch.identity))));
+
+  const forgedLegacySnapshot = JSON.parse(optedSnapshot);
+  delete forgedLegacySnapshot.chainRuntime;
+  assert.throws(() => LiveBattle.restore(canonical(forgedLegacySnapshot)),
+    /causal|witness|cancellation|chain-cancel/u,
+  "a nested cancellation record cannot be injected into an absent-policy replay");
+
+  const ordinary = createBattle({ chain: false });
+  const ordinarySnapshot = JSON.parse(ordinary.serialize());
+  assert.equal(Object.hasOwn(ordinarySnapshot, "chainRuntime"), false,
+    "the unchanged legacy constructor never writes the opt-in witness");
+  assert.ok(ordinarySnapshot.version < 64);
+});
