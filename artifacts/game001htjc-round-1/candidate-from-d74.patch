+  assert.throws(() => stepLiveBattleProjectileBoundary(causalRuntime, {
+    events: causalFailure,
+    sources: projectileBoundarySources(9),
+    tick: 0,
+  }), /no causal launch/u,
+  "a valid identity with no launch fails in the later source batch");
+  assert.equal(canonical(causalRuntime.state), beforeCausal,
+    "the failed later batch discards earlier candidate history and pending roots");
+});
