+test("LiveBattle host batching retains the 8-source direct reducer cap and final pending bound", () => {
+  let receiverTraps = 0;
+  const forgedReceiver = new Proxy({}, {
+    get() { receiverTraps += 1; return undefined; },
+    getPrototypeOf() { receiverTraps += 1; return null; },
+  });
+  assert.throws(() => stepLiveBattleProjectileBoundary(forgedReceiver, {}),
+    /receiver is invalid/u,
+    "the internal boundary capability admits only instances minted by this runtime module");
+  assert.equal(receiverTraps, 0, "weak receiver admission does not invoke hostile proxy traps");
+
+  const direct = SessionTroopProjectileRuntime.fromReceipt(PROJECTILE_RECEIPT);
+  assert.throws(() => direct.step({ events: [], sources: projectileBoundarySources(9), tick: 0 }),
+    /bounded array/u,
+    "the public direct reducer still rejects a ninth source");
+  const eight = projectileBoundarySources(8);
+  const eightEvents = [
+    projectileObservation(1, 1, "projectile-impact"),
+    projectileObservation(1, 1, "projectile-launch"),
+  ];
+  const directEight = SessionTroopProjectileRuntime.fromReceipt(PROJECTILE_RECEIPT);
+  const hostEight = SessionTroopProjectileRuntime.fromReceipt(PROJECTILE_RECEIPT);
+  const directEightOutput = directEight.step({ events: eightEvents, sources: eight, tick: 0 });
+  const hostEightOutput = stepLiveBattleProjectileBoundary(hostEight, {
+    events: eightEvents, sources: eight, tick: 0,
+  });
+  assert.deepEqual(hostEightOutput, directEightOutput);
+  assert.equal(hostEight.serialize(), directEight.serialize(),
+    "the host ingress leaves existing eight-source runtime bytes unchanged");
+
+  const boundedReceiver = SessionTroopProjectileRuntime.fromReceipt(PROJECTILE_RECEIPT);
+  assert.throws(() => stepLiveBattleProjectileBoundary(boundedReceiver, {
+    events: [], sources: projectileBoundarySources(1_025), tick: 0,
+  }), /bounded array/u, "host source projection retains the existing 1,024-unit cap");
+  assert.throws(() => stepLiveBattleProjectileBoundary(boundedReceiver, {
+    events: Array.from({ length: 4_097 }, () => null),
+    sources: projectileBoundarySources(9),
+    tick: 0,
+  }), /bounded array/u, "host event projection retains the existing 4,096-event cap");
+
+  const runtime = SessionTroopProjectileRuntime.fromReceipt(PROJECTILE_RECEIPT);
+  const eightSources = projectileBoundarySources(8);
+  const oldPendingEvents = Array.from({ length: 1_020 }, (_, index) =>
+    projectileObservation((index % 8) + 1, index + 1, "projectile-launch"));
+  runtime.step({ events: oldPendingEvents, sources: eightSources, tick: 0 });
+  assert.equal(runtime.state.pending.length, 1_020);
+
+  const tenSources = projectileBoundarySources(10);
+  const launches = tenSources.map(({ sourceId }) =>
+    projectileObservation(sourceId, 2_000 + sourceId, "projectile-launch", { tick: 1 }));
+  const impacts = tenSources.map(({ sourceId }) =>
+    projectileObservation(sourceId, 2_000 + sourceId, "projectile-impact", { tick: 1 }));
+  const output = stepLiveBattleProjectileBoundary(runtime, {
+    events: [...impacts, ...launches],
+    sources: tenSources,
+    tick: 1,
+  });
+
+  assert.equal(runtime.state.pending.length, 1_020,
+    "ten same-boundary launches temporarily exceed 1,024 before their contacts return the final state under cap");
+  const orderedLaunches = output.filter((event) => event.type === "projectile-runtime-receipt" &&
+    !Object.hasOwn(event, "status"));
+  assert.deepEqual(orderedLaunches.map(({ identity }) => identity.projectileId),
+    tenSources.map(({ sourceId }) => 2_000 + sourceId),
+    "one shared comparator preserves ascending projectile identity order across contiguous batches");
+  assert.equal(output.filter((event) => event.type === "projectile-runtime-question").length, 10);
+});
