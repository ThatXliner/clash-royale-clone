+test("same-boundary primary contact precedes ordinary damage and death in the host batch", () => {
+  const battle = createBattle();
+  stageBattle(battle, { includeStructure: false });
+  const sourceId = battle.state.units.find(({ cardId }) => cardId === "stormkite").id;
+  let pendingLaunch = null;
+  for (let elapsed = 0; elapsed < MAX_CHAIN_TICKS && pendingLaunch === null; elapsed += 1) {
+    const events = battle.step();
+    const launch = events.find((event) => event.type === "projectile-launch" &&
+      identityOf(event)?.sourceId === sourceId);
+    if (launch === undefined) continue;
+    const identity = identityOf(launch);
+    const projectile = battle.state.projectiles.find((entry) =>
+      canonical(entry.projectileIdentity) === canonical(identity));
+    if (projectile !== undefined && projectile.impactTick > battle.state.tick) {
+      pendingLaunch = { identity, projectile };
+    }
+  }
+  assert.ok(pendingLaunch);
+  while (battle.state.tick < pendingLaunch.projectile.impactTick) {
+    assert.equal(battle.state.units.find(({ id }) => id === sourceId).alive, true);
+    battle.step();
+  }
+
+  const targetId = pendingLaunch.projectile.targetId;
+  const targetBefore = battle.state.units.find(({ id }) => id === targetId);
+  assert.ok(targetBefore?.alive, "the admitted primary target is a live host unit");
+  const beforeHitpoints = targetBefore.hitpoints;
+  scheduleKillSpells(battle, sourceId);
+  const events = battle.step();
+  const primary = events.find(({ identity, type }) => type === "chain-primary-contact" &&
+    canonical(identity) === canonical(pendingLaunch.identity));
+  assert.ok(primary, "the ordinary due projectile contact is retained in its host phase");
+  assert.ok(events.some((event) => event.type === "projectile-impact" && event.status === "contact" &&
+    canonical(identityOf(event)) === canonical(pendingLaunch.identity)));
+  assert.ok(events.some(({ targetId: deadId, type }) => type === "death" && deadId === sourceId));
+  assert.equal(battle.state.units.find(({ id }) => id === sourceId).alive, false);
+  assert.ok(battle.state.units.find(({ id }) => id === targetId).hitpoints < beforeHitpoints,
+    "the primary delivered its real unit damage before the source death was committed");
+  assert.ok(chainState(battle).pending.some(({ identity }) =>
+    canonical(identity) === canonical(pendingLaunch.identity)),
+  "same-boundary source death does not erase a primary already delivered by BattleCombat");
+});
