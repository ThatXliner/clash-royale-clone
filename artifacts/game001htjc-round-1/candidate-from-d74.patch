+test("later projectile batches reject malformed and causally invalid identities atomically", () => {
+  const malformedRuntime = SessionTroopProjectileRuntime.fromReceipt(PROJECTILE_RECEIPT);
+  const beforeMalformed = canonical(malformedRuntime.state);
+  const malformed = [
+    ...Array.from({ length: 8 }, (_, index) =>
+      projectileObservation(index + 1, 3_000 + index, "projectile-launch")),
+    projectileObservation(9, 3_008, "projectile-impact", {
+      projectileIdentity: {
+        attackSequence: 1,
+        direction: "unit-to-unit",
+        forged: true,
+        projectileId: 3_008,
+        sourceId: 9,
+      },
+    }),
+  ];
+  assert.throws(() => stepLiveBattleProjectileBoundary(malformedRuntime, {
+    events: malformed,
+    sources: projectileBoundarySources(9),
+    tick: 0,
+  }), /invalid shape/u,
+  "all event identities are checked before the first batch can mutate candidate state");
+  assert.equal(canonical(malformedRuntime.state), beforeMalformed);
+
+  const causalRuntime = SessionTroopProjectileRuntime.fromReceipt(PROJECTILE_RECEIPT);
+  const beforeCausal = canonical(causalRuntime.state);
+  const causalFailure = [
+    ...Array.from({ length: 8 }, (_, index) =>
+      projectileObservation(index + 1, 4_000 + index, "projectile-launch")),
+    projectileObservation(9, 4_008, "projectile-impact"),
