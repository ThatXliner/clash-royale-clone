+  const snapshot = battle.serialize();
+  const restored = LiveBattle.restore(snapshot);
+  const fork = battle.fork();
+  assert.equal(restored.serialize(), snapshot, "restore reproduces the pending causal root");
+  assert.equal(fork.serialize(), snapshot, "fork preserves the root without sharing mutable state");
+  const pendingPrimary = chainState(battle).pending[0];
+  assert.equal(pendingPrimary.identity.projectileId, primary.identity.projectileId);
+  assert.equal(pendingPrimary.dueTick, battle.state.tick);
