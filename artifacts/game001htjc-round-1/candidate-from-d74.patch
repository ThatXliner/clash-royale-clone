+export function settleChainBoundary(capability, prepared, actualOutcomes, primaryImpacts) {
+  const policy = capabilityPolicies.get(capability);
+  const receipt = preparedPlans.get(prepared);
+  if (policy === undefined || receipt === undefined || receipt.capability !== capability) {
+    throw new TypeError("live battle chain prepared boundary is invalid or already consumed");
+  }
+  const outcomes = dense(actualOutcomes, MAX_CHAIN_CANDIDATES, "chain host outcomes")
+    .map(checkedOutcome);
+  const primaries = dense(primaryImpacts, MAX_CHAIN_CANDIDATES, "chain primary impacts")
+    .map(checkedPrimary);
+  const expectedOutcomes = new Map(receipt.selected.map(({ intent }) =>
+    [`${identityKey(intent.identity)}:${intent.hop}:${targetKey(intent.target)}`, intent]));
+  const outcomeByKey = new Map();
+  for (const outcome of outcomes) {
+    const key = `${identityKey(outcome.identity)}:${outcome.hop}:${targetKey(outcome.target)}`;
+    if (!expectedOutcomes.has(key) || outcomeByKey.has(key)) {
+      throw new TypeError("chain host outcome does not match one prepared contact");
+    }
+    outcomeByKey.set(key, outcome);
+  }
+  if (outcomeByKey.size !== expectedOutcomes.size) {
+    throw new TypeError("chain prepared contact lacks an actual host outcome");
+  }
+  const next = clone(receipt.state);
+  const events = [];
+  const dueRoots = new Set([...receipt.selected.map(({ intent }) => identityKey(intent.identity)),
+    ...receipt.terminal.map(({ identity }) => identityKey(identity))]);
+  next.pending = next.pending.filter((entry) => !dueRoots.has(identityKey(entry.identity)));
+  for (const terminal of receipt.terminal) {
+    next.history.push({
+      hop: terminal.hop,
+      identity: clone(terminal.identity),
+      outcome: "complete",
+      reason: terminal.reason,
+      target: null,
+      tick: receipt.tick,
+    });
+    events.push({ ...clone(terminal), type: "chain-complete" });
+  }
+  for (const selected of receipt.selected) {
+    const intent = selected.intent;
+    const outcome = outcomeByKey.get(
+      `${identityKey(intent.identity)}:${intent.hop}:${targetKey(intent.target)}`);
+    next.history.push({
+      hop: intent.hop,
+      identity: clone(intent.identity),
+      outcome: outcome.outcome,
+      reason: null,
+      target: clone(intent.target),
+      tick: receipt.tick,
+    });
+    events.push({
+      requestedDamage: intent.damage,
+      hop: intent.hop,
+      identity: clone(intent.identity),
+      outcome: outcome.outcome,
+      target: clone(intent.target),
+      tick: receipt.tick,
+      type: "chain-hop-contact",
+    });
+    if (outcome.outcome === "contact" && intent.hop < policy.questionReceipt.targetCap.value) {
+      next.pending.push({
+        dueTick: receipt.tick + policy.questionReceipt.hopDelayTicks.value,
+        hitTargets: [...clone(selected.hitTargets), clone(intent.target)],
+        identity: clone(intent.identity),
+        nextHop: intent.hop + 1,
+        origin: clone(selected.circle),
+      });
+      events.push({
+        dueTick: receipt.tick + 1,
+        from: clone(intent.target),
+        identity: clone(intent.identity),
+        tick: receipt.tick,
+        type: "chain-hop-pending",
+      });
+    } else {
+      const reason = outcome.outcome === "miss"
+        ? "target-unavailable-at-boundary" : "target-cap";
+      events.push({
+        identity: clone(intent.identity),
+        reason,
+        tick: receipt.tick,
+        type: "chain-complete",
+      });
+    }
+  }
+  const rootsWithPrimary = new Set();
+  for (const primary of primaries) {
+    if (primary.tick !== receipt.tick || !primary.sourceAliveAtBoundaryStart) {
+      throw new TypeError("chain primary impact is stale or contradicts pre-boundary source liveness");
+    }
+    const key = identityKey(primary.identity);
+    if (rootsWithPrimary.has(key) || next.history.some(({ identity }) => identityKey(identity) === key)) {
+      throw new TypeError("chain primary impact root is duplicate or already completed");
+    }
+    rootsWithPrimary.add(key);
+    next.history.push({
+      hop: 1,
+      identity: clone(primary.identity),
+      outcome: "contact",
+      reason: null,
+      target: clone(primary.target),
+      tick: receipt.tick,
+    });
+    if (policy.questionReceipt.targetCap.value > 1) {
+      next.pending.push({
+        dueTick: receipt.tick + policy.questionReceipt.hopDelayTicks.value,
+        hitTargets: [clone(primary.target)],
+        identity: clone(primary.identity),
+        nextHop: 2,
+        origin: clone(primary.origin),
+      });
+    }
+    events.push({
+      identity: clone(primary.identity),
+      target: clone(primary.target),
+      tick: receipt.tick,
+      type: "chain-primary-contact",
+    });
+  }
+  const checkedStateValue = checkedState(next);
+  const serialized = serializeChainRuntime(capability, checkedStateValue);
+  preparedPlans.delete(prepared);
+  return { events: freeze(events), serialized, state: checkedStateValue };
+}
