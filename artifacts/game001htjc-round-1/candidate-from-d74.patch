+  assert.ok(hopContacts.every(({ outcome, requestedDamage, target }) =>
+    outcome === "contact" && requestedDamage === 192 && target.type === "building" &&
+    target.id === structure.id), `all ten roots hit the shared building; outcomes: ${
+      JSON.stringify(hopContacts.map(({ hop, identity, outcome, requestedDamage, target }) =>
+        ({ hop, identity, outcome, requestedDamage, target })))}`);
+  const finalStructure = battle.state.structures.find(({ id }) => id === structure.id);
+  assert.equal(finalStructure.hitpoints, 0,
+    "the shared LiveBattle structure health owner clamps the aggregate overkill to zero");
+  const structureDamage = hopEvents.filter(({ buildingId, origin, type }) =>
+    type === "structure-damaged" && buildingId === structure.id && origin === "chain-hop");
+  assert.equal(structureDamage.reduce((sum, { amountApplied }) => sum + amountApplied, 0), 1_749,
+    "the building owner reports its actual total applied health delta");
+  assert.equal(structureDamage.at(-1).amountApplied, 21,
+    "the final root applies only remaining building health rather than its full request");
+  assert.equal(hopContacts.reduce((sum, { requestedDamage }) => sum + requestedDamage, 0), 1_920);
+  assert.ok(hopContacts.reduce((sum, { requestedDamage }) => sum + requestedDamage, 0) >
+    structure.hitpoints);
